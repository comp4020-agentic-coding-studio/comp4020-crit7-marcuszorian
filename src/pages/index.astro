---
import { listCards, rankMatches } from "../lib/db";
import { BLOCKS, TAGS } from "../lib/schema";
import "../styles.css";

const allCards = listCards();
const board = allCards.map((card) => ({
  card,
  matches: rankMatches(allCards, card.id),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Study/project matches</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Board</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Study/project matches</h1>
      <p>
        Post a card with your course, idea, topic tags and weekly
        availability. You'll see who you're actually compatible with below —
        ranked by shared tags and overlapping availability, not just a flat
        list.
      </p>

      <form method="post" action="/api/cards">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" required maxlength="100" />
        </div>
        <div class="field">
          <label for="contact">Contact</label>
          <input id="contact" name="contact" required maxlength="100" placeholder="email or Discord handle" />
        </div>
        <div class="field">
          <label for="courseCode">Course code</label>
          <input id="courseCode" name="courseCode" required maxlength="20" placeholder="COMP4020" />
        </div>
        <div class="field">
          <label for="idea">Idea</label>
          <textarea id="idea" name="idea" required maxlength="280"></textarea>
        </div>
        <fieldset>
          <legend>Topics</legend>
          {
            TAGS.map((tag) => (
              <label class="checkbox">
                <input type="checkbox" name="tags" value={tag} /> {tag}
              </label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>Availability</legend>
          {
            BLOCKS.map((block) => (
              <label class="checkbox">
                <input type="checkbox" name="blocks" value={block} /> {block}
              </label>
            ))
          }
        </fieldset>
        <button>Post card</button>
      </form>

      <section aria-label="cards">
        {
          board.map(({ card, matches }) => (
            <article class="card">
              <h2>{card.name}</h2>
              <p class="meta">
                {card.contact} · {card.courseCode}
              </p>
              <p>{card.idea}</p>
              <ul class="tags">
                {card.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <ul class="blocks">
                {card.blocks.map((block) => (
                  <li>{block}</li>
                ))}
              </ul>
              <div class="matches">
                <h3>Matches</h3>
                {matches.length === 0 ? (
                  <p>No matches yet.</p>
                ) : (
                  <ul>
                    {matches.map(({ card: match, score }) => (
                      <li>
                        {match.name} — {score.toFixed(1)}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>
